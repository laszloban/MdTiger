{
  "name": "mdtiger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MdTiger: a fast Markdown viewer and editor",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node --test --test-concurrency=1 tests/e2e/",
    "check": "npm run check:ci && npm run e2e",
    "check:ci": "npm run typecheck && npm test && tauri build --no-bundle && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.0",
    "@lezer/common": "^1.5.7",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.2",
    "@tauri-apps/api": "^2.12.5",
    "lucide": "^1.81.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
