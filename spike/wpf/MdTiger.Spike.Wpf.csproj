<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MdTigerSpikeWpf</AssemblyName>
    <RootNamespace>MdTiger.Spike.Wpf</RootNamespace>
    <ApplicationIcon>..\tauri\src-tauri\icons\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Startup: precompiled code avoids most JIT work on launch (NFR-01). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <!-- The shared front end, built by `npm run build` in ../frontend. -->
  <ItemGroup>
    <Content Include="..\frontend\dist\**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
