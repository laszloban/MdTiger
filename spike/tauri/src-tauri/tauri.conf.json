{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MdTigerSpikeTauri",
  "version": "0.0.0",
  "identifier": "com.laszloban.mdtiger.spike",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MdTiger spike (Tauri 2)",
        "width": 1280,
        "height": 860
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
